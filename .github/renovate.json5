{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>gradle/renovate-agent//presets/dv.json5"
  ],
  enabledManagers: ["maven", "custom.regex"],
  packageRules: [
    // Disable all native Maven dependencies except what we manage
    {
      matchManagers: ["maven"],
      enabled: false
    },
    {
      matchManagers: ["maven"],
      matchPackageNames: [
        "com.gradle:develocity-maven-extension",
        "com.gradle:common-custom-user-data-maven-extension"
      ],
      enabled: true
    },
    // Auto-merge minor and patch
    {
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr"
    }
  ],
  customManagers: [],
  postUpgradeTasks: {
    commands: ["bash .github/renovate/post-upgrade.sh"],
    fileFilters: ["src/test/java/com/gradle/develocity/bamboo/MavenEmbeddedResourcesTest.java"],
    executionMode: "branch"
  }
}
